{
  "manifest_version": 3,
  "name": "Impulse Guard",
  "version": "1.0",
  "description": "Your late-night sobriety checkpoint for online shopping.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:2600/*",
    "http://localhost:2600/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unlock Cart"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.co.uk/*"
      ],
      "js": ["content.js"]
    }
  ]
}